  "private": true,
  "description": "Independent, unofficial bilingual (ID/EN) guide to how ICANN works, with every claim sourced.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
